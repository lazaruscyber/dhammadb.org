#!/bin/bash
# Packs every Markdown file in pages/ into pages/_bundle.js so the wiki
# can be opened straight from disk (file://) without a web server.
# On a Mac: double-click this file. Anywhere else: run  bash build.command

cd "$(dirname "$0")" || exit 1
out="pages/_bundle.js"
tmp="$out.tmp"
count=0

{
  echo "/* Generated by build.command on $(date). Do not edit; edit the .md files instead. */"
  echo "window.WIKI_FILES = [];"
  while IFS= read -r -d '' f; do
    rel="${f#pages/}"
    mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)
    case "$mtime" in ''|*[!0-9]*) mtime=0 ;; esac
    name=$(printf '%s' "$rel" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    # SHA-256 of the file's exact contents: it changes only when the page changes.
    hash=$( (shasum -a 256 "$f" 2>/dev/null || sha256sum "$f") | cut -d ' ' -f 1)
    printf 'window.WIKI_FILES.push({file:"%s",mtime:%s,hash:"%s",text:`' "$name" "$mtime" "$hash"
    # Escape characters that are special inside a JavaScript template string.
    sed -e 's/\\/\\\\/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' "$f"
    printf '`});\n'
    count=$((count + 1))
  done < <(find pages -type f -name '*.md' ! -name '.*' -print0 | sort -z)
} > "$tmp" && mv "$tmp" "$out"

echo "Built $out from $count page(s)."
echo "You can close this window and reload the wiki in your browser."
